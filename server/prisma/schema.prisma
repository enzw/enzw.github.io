generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WalletType {
  CASH
  BANK
  E_WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVING
}

enum IncomeType {
  PRIMARY
  SECONDARY
}

enum ExpenseType {
  FIXED
  VARIABLE
  SUBSCRIPTION
  DEBT
  DISCRETIONARY
}

model User {
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String
  email                 String             @unique
  passwordHash          String
  avatarEmoji           String?
  wallets               Wallet[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  savingGoals           SavingGoal[]
  savingGoalMemberships SavingGoalMember[]
  subscriptions         Subscription[]
  debts                 Debt[]
  walletTransfers       WalletTransfer[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model Wallet {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  name              String
  type              WalletType
  openingBalance    Decimal          @default(0) @db.Decimal(18, 2)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  subscriptions     Subscription[]
  debts             Debt[]
  outgoingTransfers WalletTransfer[] @relation("TransferFromWallet")
  incomingTransfers WalletTransfer[] @relation("TransferToWallet")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model WalletTransfer {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  fromWalletId String   @db.Uuid
  toWalletId   String   @db.Uuid
  amount       Decimal  @db.Decimal(18, 2)
  date         DateTime
  note         String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromWallet   Wallet   @relation("TransferFromWallet", fields: [fromWalletId], references: [id], onDelete: Restrict)
  toWallet     Wallet   @relation("TransferToWallet", fields: [toWalletId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([userId, date])
  @@index([fromWalletId])
  @@index([toWalletId])
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String
  expenseType  ExpenseType
  color        String?
  isActive     Boolean       @default(true)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  walletId     String          @db.Uuid
  categoryId   String?         @db.Uuid
  savingGoalId String?         @db.Uuid
  type         TransactionType
  incomeType   IncomeType?
  expenseType  ExpenseType?
  amount       Decimal         @db.Decimal(18, 2)
  date         DateTime
  note         String?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  savingGoal   SavingGoal?     @relation(fields: [savingGoalId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, date])
  @@index([walletId])
  @@index([categoryId])
}

model Budget {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  categoryId String?   @db.Uuid
  month      DateTime
  amount     Decimal   @db.Decimal(18, 2)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

model SavingGoal {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.Uuid
  name                 String
  targetAmount         Decimal            @db.Decimal(18, 2)
  targetDate           DateTime?
  priority             Int                @default(1)
  plannedMonthlyAmount Decimal            @default(0) @db.Decimal(18, 2)
  isActive             Boolean            @default(true)
  isShared             Boolean            @default(false)
  shareCode            String?            @unique @db.Char(6)
  shareCodeExpiresAt   DateTime?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  members              SavingGoalMember[]
  transactions         Transaction[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, priority])
}

model SavingGoalMember {
  savingGoalId String     @db.Uuid
  userId       String     @db.Uuid
  savingGoal   SavingGoal @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt     DateTime   @default(now())

  @@id([savingGoalId, userId])
  @@index([userId])
}

model Subscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  walletId   String?  @db.Uuid
  name       String
  amount     Decimal  @db.Decimal(18, 2)
  billingDay Int
  isActive   Boolean  @default(true)
  note       String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet     Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Debt {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  walletId        String?   @db.Uuid
  name            String
  originalAmount  Decimal   @db.Decimal(18, 2)
  remainingAmount Decimal   @db.Decimal(18, 2)
  monthlyPayment  Decimal?  @db.Decimal(18, 2)
  dueDate         DateTime?
  isPaid          Boolean   @default(false)
  note            String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}
